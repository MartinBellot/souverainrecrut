# {{ ansible_managed }}
# Secrets générés une seule fois sur le serveur (jamais versionnés). Mode 0600.
POSTGRES_USER={{ postgres_user }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}
JWT_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['ascii_letters', 'digits']) }}
FRONTEND_URL={{ frontend_url }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=20, chars=['ascii_letters', 'digits']) }}
