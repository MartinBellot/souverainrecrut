# {{ ansible_managed }}
# Configuration initiale générée sur le serveur (mode 0600, jamais versionnée).
# Mêmes clés que deployment/.env.example ; régénéré ensuite par GitLab CI.
BACKEND_IMAGE={{ backend_image }}
API_PORT={{ api_port }}
POSTGRES_IMAGE={{ postgres_image }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}
JWT_SECRET={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['ascii_letters', 'digits']) }}
FRONTEND_URL={{ frontend_url }}
BACKUP_KEEP=7
