# ======================================================
# Modèle du fichier .env de production (à copier en .env sur le serveur, mode 0600).
# Le vrai .env n'est JAMAIS versionné : il est généré par le pipeline GitLab à partir
# des variables CI/CD protégées et masquées (ou par Ansible à l'installation initiale).
# ======================================================

# --- Image Backend (le tag déployé est dans release.env, géré par deploy.sh)
BACKEND_IMAGE=martinbellot/souverainrecrut-backend

# --- Réseau
API_PORT=4000

# --- PostgreSQL (le mot de passe est fixé à la création du volume : ne pas le changer ensuite)
POSTGRES_IMAGE=postgres:16.15-alpine3.24
POSTGRES_USER=souverainrecrut
POSTGRES_DB=souverainrecrut
POSTGRES_PASSWORD=change-me-32-caracteres-alphanumeriques

# --- API
JWT_SECRET=change-me-64-caracteres-alphanumeriques
FRONTEND_URL=http://localhost:5173

# --- Sauvegardes (deploy.sh fait un pg_dump avant chaque déploiement)
BACKUP_KEEP=7
