{
  "name": "souverainrecrut-backend",
  "version": "1.0.0",
  "description": "API REST de la plateforme SouverainRecrut développée avec Node.js, Express, TypeScript et Prisma.",
  "author": "Bootcamp DevOps Conakry 2026",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "lint": "echo \"ESLint sera configuré plus tard\"",
    "format": "echo \"Prettier sera configuré plus tard\"",
    "test": "jest --selectProjects unit integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "npm run test:db:up && jest --runInBand --coverage",
    "test:coverage": "jest --selectProjects unit integration --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:ci": "jest --selectProjects unit integration --ci --maxWorkers=2 --coverage --reporters=default --reporters=jest-junit --reporters=jest-sonar"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "devops",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "rest-api"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "classNameTemplate": "{displayName} › {classname}",
    "titleTemplate": "{title}"
  }
}
