# Copier en ci/.env (non versionné) puis renseigner les valeurs.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Dépôt cloné par Jenkins (branche Dev)
GIT_REPOSITORY_URL=https://github.com/MartinBellot/souverainrecrut.git

# Docker Hub : utiliser un "Access Token" (Account settings → Security), pas le mot de passe
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Token d'analyse SonarQube (My Account → Security → Global Analysis Token)
SONAR_TOKEN=
